{
  "dependencies": {
    "@next/env": "16.2.9",
    "async-retry": "1.3.3",
    "bcryptjs": "3.0.3",
    "cookie": "1.1.1",
    "eslint": "8.57.0",
    "next": "^16.2.9",
    "next-connect": "^1.0.0",
    "node-pg-migrate": "7.9.1",
    "nodemailer": "^9.0.1",
    "pg": "8.22.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-server-dom-parcel": "^19.2.7",
    "react-server-dom-turbopack": "^19.2.7",
    "react-server-dom-webpack": "^19.2.7",
    "swr": "^2.4.1",
    "uuid": "11.1.0"
  },
  "name": "clone-tabnews",
  "description": "",
  "version": "1.0.0",
  "main": "index.js",
  "devDependencies": {
    "dotenv": "17.4.2",
    "dotenv-expand": "13.0.0",
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@commitlint/cli": "21.0.2",
    "@commitlint/config-conventional": "21.0.2",
    "@faker-js/faker": "9.7.0",
    "@typescript-eslint/parser": "8.61.1",
    "babel-jest": "^30.4.1",
    "commitizen": "4.3.2",
    "concurrently": "10.0.3",
    "cz-conventional-changelog": "3.3.0",
    "eslint-config-next": "15.3.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jest": "28.11.0",
    "husky": "9.1.7",
    "jest": "30.4.2",
    "prettier": "3.8.4",
    "set-cookie-parser": "3.1.0"
  },
  "scripts": {
    "dev": "trap \"npm run postdev\" INT TERM ; npm run services:up && npm run services-wait-database && npm run migrations:up && next dev",
    "postdev": "npm run services:stop",
    "test": "npm run services:up && concurrently --names next,jest --hide next --kill-others --success command-jest \"next dev\" \"jest --runInBand\"",
    "posttest": "npm run services:stop",
    "test:watch": "jest --watchAll --runInBand --verbose",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:stop": "docker compose -f infra/compose.yaml stop",
    "services:down": "docker compose -f infra/compose.yaml down",
    "services-wait-database": "node infra/scripts/wait-for-postgres.js",
    "lint:prettier:check": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "lint:eslint:check": "npx eslint .",
    "migrations:create": "node-pg-migrate --migrations-dir infra/migrations create",
    "migrations:up": "node-pg-migrate --migrations-dir infra/migrations --envPath .env.development up",
    "migrations:up:dry": "node-pg-migrate --migrations-dir infra/migrations --envPath .env.development --dry-run up",
    "prepare": "husky",
    "commit": "cz"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Edpow/clone-tabnews.git"
  },
  "keywords": [
    "clone",
    "tabnews",
    "estudo",
    "study",
    "react",
    "node",
    "js"
  ],
  "author": "Edgar R. Arruda",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Edpow/clone-tabnews/issues"
  },
  "homepage": "https://github.com/Edpow/clone-tabnews#readme",
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "engines": {
    "node": "24"
  }
}
